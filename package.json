{
  "name": "bidline",
  "version": "0.1.0",
  "private": true,
  "description": "Supplier quote comparison that runs on your own Claude via MCP. Claude reads the quotes; Bidline does the maths, keeps the record and gets it approved. No AI inside.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "types": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "test:calc": "tsx scripts/calc-test.ts",
    "test:mcp": "tsx --env-file=.env.local scripts/mcp-e2e.ts",
    "check:no-ai": "tsx scripts/no-ai-check.ts",
    "verify": "npm run check:no-ai && npm run types && npm run lint && npm run test:calc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "fflate": "^0.8.3",
    "lucide-react": "^1.43.0",
    "mailparser": "^3.9.23",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "nodemailer": "^7.0.13",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}

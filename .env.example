# Copy to .env.local and fill in. On Vercel, `vercel env pull .env.local --yes` does this for you.

# Postgres (Neon). Required. Run `npm run db:migrate` once to create the tables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs session cookies and encrypts saved mailbox passwords. Any long random string.
# Changing it signs everybody out.
AUTH_SECRET=

# Vercel Blob read-write token, for supplier files. Required for uploads.
BLOB_READ_WRITE_TOKEN=

# Public address of the app, used in connector and approval links. Optional on Vercel.
APP_URL=http://localhost:3000

# Protects the daily reminders job; Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Only for `npm run test:mcp`: the running app to test against.
BIDLINE_URL=http://localhost:3000
